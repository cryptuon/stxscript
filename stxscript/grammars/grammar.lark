// StxScript Lark Grammar

// Root rule
start: (statement | function_declaration | class_declaration)*

// Statements
statement: variable_declaration
         | constant_declaration
         | expression_statement
         | if_statement
         | try_catch_statement
         | throw_statement
         | return_statement

// Declarations
variable_declaration: decorator* "let" IDENTIFIER [":" type] "=" expression ";"
constant_declaration: "const" IDENTIFIER [":" type] "=" expression ";"
function_declaration: decorator* "function" IDENTIFIER "(" [parameter_list] ")" [":" type] block
class_declaration: decorator* "class" IDENTIFIER ["implements" IDENTIFIER ("," IDENTIFIER)*] "{" class_body "}"

// Expression statement
expression_statement: expression ";"

// Function-related
parameter_list: parameter ("," parameter)*
parameter: IDENTIFIER ":" type
lambda_function: "(" [parameter_list] ")" "=>" (expression | block)

// Types
type: "int" | "uint" | "boolean" | "string" | "buffer" | "principal" | "trait"
    | "list" "<" type ">"
    | "optional" "<" type ">"
    | "{" [tuple_type_list] "}"
    | "Response" "<" type "," type ">"
    | "Map" "<" type "," type ">"

tuple_type_list: IDENTIFIER ":" type ("," IDENTIFIER ":" type)*

// Expressions
expression: literal
          | IDENTIFIER
          | binary_operation
          | unary_operation
          | function_call
          | member_access
          | array_access
          | lambda_function
          | "(" expression ")"
          | ternary_operation
          | type_assertion
          | type_check
          | optional_none
          | optional_some
          | unwrap_expression
          | ok_expression
          | err_expression
          | new_expression

binary_operation: expression operator expression
unary_operation: operator expression

operator: "+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | ">" | "<=" | ">=" | "&&" | "||" | "&" | "|" | "^" | "<<" | ">>" | "??" | "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>="

ternary_operation: expression "?" expression ":" expression

function_call: (IDENTIFIER | member_access) "(" [argument_list] ")"
argument_list: (named_argument | expression) ("," (named_argument | expression))*
named_argument: IDENTIFIER ":" expression

member_access: expression "." IDENTIFIER

array_access: expression "[" expression "]"

type_assertion: expression "as" type
type_check: expression "is" type

optional_none: "none" "(" ")"
optional_some: "some" "(" expression ")"
unwrap_expression: expression "!"

ok_expression: "ok" "(" expression ")"
err_expression: "err" "(" expression ")"

new_expression: "new" type "(" [argument_list] ")"

// Control structures
if_statement: "if" "(" expression ")" block ["else" (if_statement | block)]
try_catch_statement: "try" block "catch" "(" IDENTIFIER ":" type ")" block
throw_statement: "throw" expression ";"
return_statement: "return" expression ";"

// Block
block: "{" statement* "}"

// Class body
class_body: (function_declaration | variable_declaration)*

// Decorators
decorator: "@" IDENTIFIER ["(" [argument_list] ")"]

// Literals
literal: INTEGER
       | UINTEGER
       | STRING
       | BOOLEAN
       | PRINCIPAL
       | list_literal
       | tuple_literal

INTEGER: /-?[0-9]+/
UINTEGER: /[0-9]+u/
STRING: /".*?"/
BOOLEAN: "true" | "false"
PRINCIPAL: /'SP[A-Z0-9]+'/
list_literal: "[" [expression ("," expression)*] "]"
tuple_literal: "{" IDENTIFIER ":" expression ("," IDENTIFIER ":" expression)* "}"
             | "{" "}"

// Identifier
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

// Ignore whitespace and comments
%import common.WS
%ignore WS
COMMENT: /\/\/[^\n]*/
         | /\/\*(.|\n)*?\*\//
%ignore COMMENT
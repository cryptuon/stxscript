// StxScript Grammar - Full TypeScript-like features
// Supports: classes, bitwise ops, contract calls, typed lambdas, optional chaining

// =============================================================================
// TOKENS - Priority-ordered literals and keywords
// =============================================================================

// Literals (higher priority first)
UINTEGER.3: /[0-9]+u/
INTEGER.2: /-?[0-9]+/
STRING: /"[^"]*"/
BOOLEAN.3: "true" | "false"
PRINCIPAL.2: /'[A-Z0-9]+(\.[a-zA-Z][a-zA-Z0-9_-]*)*/

// Type keywords (high priority to avoid matching as IDENTIFIER)
BOOL_TYPE.2: "bool"
INT_TYPE.2: "int"
UINT_TYPE.2: "uint"
BOOLEAN_TYPE.2: "boolean"
STRING_TYPE.2: "string"
BUFFER_TYPE.2: "buffer"
PRINCIPAL_TYPE.2: "principal"
RESPONSE.2: "Response"
OPTIONAL.2: "optional"
LIST.2: "list"
MAP_TYPE.2: "Map"

// Special keywords (must come before IDENTIFIER)
UNWRAP.3: "unwrap!"
TRY.3: "try!"

// Reserved words
CLASS.2: "class"
TRAIT.2: "trait"
IMPLEMENTS.2: "implements"
NEW.2: "new"
THIS.2: "this"
FUNCTION.2: "function"
LET.2: "let"
CONST.2: "const"
RETURN.2: "return"
IF.2: "if"
ELSE.2: "else"
MATCH.2: "match"
IMPORT.2: "import"
EXPORT.2: "export"
FROM.2: "from"
IN.2: "in"
SOME.2: "some"
NONE.2: "none"
OK.2: "ok"
ERR.2: "err"
MAP_KW.2: "map"
TYPE_KW.2: "type"
FOR.2: "for"
WHILE.2: "while"

// Identifier (must come after all keywords)
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

// =============================================================================
// ROOT RULE
// =============================================================================

start: top_level_item*

top_level_item: class_declaration
              | function_declaration
              | trait_declaration
              | variable_declaration
              | constant_declaration
              | map_declaration
              | type_alias_declaration
              | import_statement
              | export_statement

// =============================================================================
// TYPE ALIAS DECLARATIONS
// =============================================================================

type_alias_declaration: TYPE_KW IDENTIFIER "=" type ";"

// =============================================================================
// CLASS DECLARATIONS
// =============================================================================

class_declaration: decorator* CLASS IDENTIFIER [IMPLEMENTS IDENTIFIER] "{" class_member* "}"

class_member: function_declaration
            | field_declaration
            | map_declaration

field_declaration: decorator* IDENTIFIER ":" type ["=" expression] ";"

// =============================================================================
// FUNCTION DECLARATIONS
// =============================================================================

function_declaration: decorator* FUNCTION IDENTIFIER [generic_params] "(" [parameter_list] ")" [":" type] block

// Generic type parameters: <T>, <T, U>, etc.
generic_params: "<" TYPE_PARAM ("," TYPE_PARAM)* ">"
TYPE_PARAM: /[A-Z]/

parameter_list: parameter ("," parameter)*
parameter: IDENTIFIER ":" type

// =============================================================================
// TRAIT DECLARATIONS
// =============================================================================

trait_declaration: TRAIT IDENTIFIER "{" trait_method* "}"
trait_method: IDENTIFIER "(" [parameter_list] ")" [":" type] ";"

// =============================================================================
// STATEMENTS
// =============================================================================

statement: variable_declaration
         | constant_declaration
         | assignment_statement
         | return_statement
         | if_statement
         | for_statement
         | while_statement
         | map_declaration
         | map_operation
         | expression_statement

// For loop: for (let i = 0; i < 10; i = i + 1) { body }
for_statement: FOR "(" for_init ";" expression ";" for_update ")" block
for_init: LET IDENTIFIER [":" type] "=" expression
for_update: IDENTIFIER "=" expression

// While loop: while (condition) { body }
while_statement: WHILE "(" expression ")" block

variable_declaration: LET IDENTIFIER [":" type] "=" expression ";"
constant_declaration: CONST IDENTIFIER [":" type] "=" expression ";"

assignment_statement: IDENTIFIER "=" expression ";"

return_statement: RETURN [expression] ";"

if_statement: IF "(" expression ")" block [ELSE (if_statement | block)]

expression_statement: expression ";"

// =============================================================================
// MAP DECLARATIONS AND OPERATIONS
// =============================================================================

map_declaration: MAP_KW IDENTIFIER "<" type "," type ">" ";"

map_operation: map_insert | map_update | map_delete

map_insert: IDENTIFIER ".insert" "(" expression "," expression ")" ";"
map_update: IDENTIFIER ".update" "(" expression "," expression ")" ";"
map_delete: IDENTIFIER ".delete" "(" expression ")" ";"

// =============================================================================
// IMPORT/EXPORT
// =============================================================================

import_statement: IMPORT "{" import_list "}" FROM STRING ";"
import_list: IDENTIFIER ("," IDENTIFIER)*

export_statement: EXPORT (function_declaration | variable_declaration | constant_declaration)

// =============================================================================
// TYPES - Comprehensive type system
// =============================================================================

type: simple_type
    | response_type
    | optional_type
    | list_type
    | map_type
    | tuple_type
    | custom_type

simple_type: INT_TYPE -> int_type
           | UINT_TYPE -> uint_type
           | BOOL_TYPE -> bool_type
           | BOOLEAN_TYPE -> bool_type
           | STRING_TYPE -> string_type
           | BUFFER_TYPE "<" INTEGER ">" -> sized_buffer_type
           | BUFFER_TYPE -> buffer_type
           | PRINCIPAL_TYPE -> principal_type

// Custom type reference (type aliases)
custom_type: IDENTIFIER

// Tuple type: { field: Type, ... }
tuple_type: "{" tuple_type_field ("," tuple_type_field)* "}"
tuple_type_field: IDENTIFIER ":" type

response_type: RESPONSE "<" type "," type ">"
optional_type: OPTIONAL "<" type ">"
list_type: LIST "<" type ">"
map_type: MAP_TYPE "<" type "," type ">"

// =============================================================================
// EXPRESSIONS - Precedence from lowest to highest
// =============================================================================

expression: nullish_coalescing

// Nullish coalescing (??) - lowest precedence
?nullish_coalescing: ternary (NULLISH_OP ternary)*
NULLISH_OP: "??"

// Ternary (for future support, currently pass-through)
?ternary: logical_or

// Logical OR
?logical_or: logical_and (OR_OP logical_and)*
OR_OP: "||"

// Logical AND
?logical_and: bitwise_or (AND_OP bitwise_or)*
AND_OP: "&&"

// Bitwise OR
?bitwise_or: bitwise_xor (BIT_OR bitwise_xor)*
BIT_OR: "|"

// Bitwise XOR
?bitwise_xor: bitwise_and (BIT_XOR bitwise_and)*
BIT_XOR: "^"

// Bitwise AND
?bitwise_and: equality (BIT_AND equality)*
BIT_AND: "&"

// Equality
?equality: comparison (EQ_OP comparison)*
EQ_OP: "==" | "!="

// Comparison
?comparison: shift ((COMP_OP | LESSTHAN | MORETHAN) shift)*
COMP_OP.2: "<=" | ">="
LESSTHAN: "<"
MORETHAN: ">"

// Bit shift
?shift: addition (SHIFT_OP addition)*
SHIFT_OP.2: "<<" | ">>"

// Addition/Subtraction
?addition: multiplication (ADD_OP multiplication)*
ADD_OP: "+" | "-"

// Multiplication/Division/Modulo
?multiplication: unary (MUL_OP unary)*
MUL_OP: "*" | "/" | "%"

// Unary operators
?unary: NOT_OP unary -> unary_not
      | MINUS unary -> unary_neg
      | PLUS unary -> unary_pos
      | BIT_NOT unary -> unary_bitnot
      | power

NOT_OP: "!"
MINUS: "-"
PLUS: "+"
BIT_NOT: "~"

// Power
?power: postfix (POW_OP unary)?
POW_OP: "**"

// Postfix operators (force unwrap, method chains)
?postfix: primary postfix_op*

postfix_op: "!" -> force_unwrap
          | "." IDENTIFIER "(" [argument_list] ")" -> method_call
          | "." IDENTIFIER -> member_access
          | "[" expression "]" -> index_op

// Primary expressions
?primary: literal
        | IDENTIFIER -> identifier
        | PRINCIPAL -> principal_literal
        | THIS -> this_expr
        | call_expr
        | new_expression
        | match_expression
        | let_expression
        | unwrap_expression
        | try_expression
        | list_literal
        | tuple_literal
        | some_expression
        | none_expression
        | ok_expression
        | err_expression
        | lambda_expression
        | "(" expression ")" -> grouped_expr

// =============================================================================
// CALL EXPRESSIONS - Unified function and contract calls
// =============================================================================

// Handle both function calls and contract.method calls
call_expr: IDENTIFIER "(" [argument_list] ")" -> function_call
         | IDENTIFIER "." IDENTIFIER "(" [argument_list] ")" -> contract_call

argument_list: expression ("," expression)*

// New expression for Map/etc
new_expression: NEW IDENTIFIER "<" type ("," type)* ">" "(" ")"

// =============================================================================
// SPECIAL EXPRESSIONS
// =============================================================================

match_expression: MATCH expression "{" match_arm+ "}"
match_arm: pattern "=>" expression ";"
pattern: IDENTIFIER | literal | "_"

let_expression: LET "{" let_binding+ "}" IN expression
let_binding: IDENTIFIER "=" expression ";"

unwrap_expression: UNWRAP "(" expression ")"
try_expression: TRY "(" expression ")"

some_expression: SOME "(" expression ")"
none_expression: NONE "(" ")"

ok_expression: OK "(" expression ")"
err_expression: ERR "(" expression ")"

// =============================================================================
// LAMBDA EXPRESSIONS - Must have arrow to distinguish from grouped expr
// =============================================================================

// Typed lambda: (x: int, y: int): int => expr
// Untyped lambda: (x, y) => expr
// No-param lambda: () => expr
lambda_expression: "(" typed_params ")" ":" type "=>" lambda_body -> typed_lambda
                 | "(" ")" "=>" lambda_body -> empty_lambda
                 | "(" IDENTIFIER ("," IDENTIFIER)* ")" "=>" lambda_body -> untyped_lambda

typed_params: typed_param ("," typed_param)*
typed_param: IDENTIFIER ":" type

lambda_body: expression

// =============================================================================
// LIST AND TUPLE LITERALS
// =============================================================================

list_literal: "[" [expression ("," expression)*] "]"

// Tuple must have at least one field to distinguish from empty block
tuple_literal: "{" tuple_field ("," tuple_field)* "}"
tuple_field: IDENTIFIER ":" expression

// =============================================================================
// BLOCK - Cannot be empty (use statement* which allows empty)
// =============================================================================

block: "{" statement* "}"

// =============================================================================
// DECORATORS
// =============================================================================

decorator: "@" IDENTIFIER

// =============================================================================
// LITERALS
// =============================================================================

literal: INTEGER -> integer_literal
       | UINTEGER -> uinteger_literal
       | STRING -> string_literal
       | BOOLEAN -> boolean_literal

// =============================================================================
// COMMENTS - Ignored
// =============================================================================

SINGLE_LINE_COMMENT: "//" /[^\n]*/
DOC_COMMENT: "///" /[^\n]*/
MULTI_LINE_COMMENT: "/*" /(.|\n)*?/ "*/"

// =============================================================================
// WHITESPACE - Ignored
// =============================================================================

%import common.WS
%ignore WS
%ignore SINGLE_LINE_COMMENT
%ignore DOC_COMMENT
%ignore MULTI_LINE_COMMENT
